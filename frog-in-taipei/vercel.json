{
  "cleanUrls": true,
  "headers": [
    { "source": "/config/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/src/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }] },
    { "source": "/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
